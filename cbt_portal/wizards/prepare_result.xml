<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="prepare_result_wiz" model="ir.ui.view">
        <field name="name">prepare.result.wizard</field>
        <field name="model">prepare.result.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Candidate Results Workbook">
                <sheet>
                    <group>
                        <field name="batch_id" options="{'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="prepare_result" string="Export Results Workbook" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="prepare_result_wizard_action" model="ir.actions.act_window">
        <field name="name">Export Candidate Results Workbook</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">prepare.result.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem
        id="perpare_result_menu"
        name="Export Candidate Results Workbook"
        action="cbt_portal.prepare_result_wizard_action"
        parent="cbt_portal.menu_cbt_portal_main"
        groups="cbt.group_cbt_admin"/>

</odoo>