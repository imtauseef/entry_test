<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cbt_paper_export_batch_tree" model="ir.ui.view">
        <field name="name">cbt.paper.export.batch.tree</field>
        <field name="model">cbt.paper.export.batch</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="state"/>
                <field name="activated_at"/>
                <field name="finished_at"/>
                <field name="results_collected_at"/>
            </tree>
        </field>
    </record>

    <record id="cbt_paper_export_batch_form" model="ir.ui.view">
        <field name="name">cbt.paper.export.batch.form</field>
        <field name="model">cbt.paper.export.batch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_start_test" string="Start Test"
                            type="object" class="btn-primary"
                            invisible="state != 'imported'"/>
                    <button name="action_finish_test" string="Finish Test"
                            type="object" class="btn-primary"
                            invisible="state != 'active'"/>
                    <button name="action_open_results_export_password_prompt" string="Export Results Workbook"
                            type="object" invisible="state not in ('finished', 'result_collected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="imported,active,finished,result_collected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="source_system_id" invisible="1"/>
                            <field name="source_export_id" invisible="1"/>
                            <field name="source_generator_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="activated_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="results_collected_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Candidate Papers">
                            <field name="paper_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="login"/>
                                    <field name="name"/>
                                    <field name="paper_name"/>
                                    <field name="test_center"/>
                                    <field name="paper_started"/>
                                    <field name="end_paper"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cbt_paper_export_batch_action" model="ir.actions.act_window">
        <field name="name">Test Batches</field>
        <field name="res_model">cbt.paper.export.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_cbt_portal_test_batches"
              name="Test Batches"
              parent="menu_cbt_portal_main"
              action="cbt_paper_export_batch_action"
              groups="cbt.group_cbt_admin"
              sequence="30"/>
</odoo>
