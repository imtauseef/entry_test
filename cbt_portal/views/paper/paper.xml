<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cbt_paper" name="">
        <t t-call="web.layout">
            <t t-set="body_classname" t-value="'cbt-portal-body'"/>
            <t t-set="title" t-value="'CBT - Paper'"/>
            <t t-set="head">
                <t t-call-assets="cbt_portal.assets_dashboard" t-js="false"/>
                <script src="/cbt_portal/static/js/jquery-2.1.4.min.js"/>
                <script src="/cbt_portal/static/js/paginga_jquery.js"/>
                <style>
                    #fix_align p img {
                    height: 45px;
                    margin-top: -82%;
                    margin-bottom: -19%;
                    margin-right: -20%;
                    margin-left: 10%;
                    }
                    .green{
                    color:green !important;
                    }
                    .pager .pageNumbers a.active{
                    color: green !important;
                    font-weight: bold;
                    }
                    .pager .pageNumbers a {
                    display: inline-block;
                    padding: 0 10px;
                    color: orange !important;
                    }
                    .firstPage{
                    background-color:#6666ff;
                    color:white;
                    }
                    .previousPage{
                    background-color:#6666ff;
                    color:white;
                    }
                    .nextPage{
                    background-color:#6666ff;
                    color:white;
                    }
                    .lastPage{
                    background-color:#6666ff;
                    color:white;
                    }
                    .firstPage:hover{
                    background-color:grey;
                    color: white;
                    cursor: pointer;
                    }
                    .previousPage:hover{
                    background-color:grey;
                    color: white;
                    cursor: pointer;
                    }
                    .nextPage:hover{
                    background-color:grey;
                    color: white;
                    cursor: pointer;
                    }
                    .lastPage:hover{
                    background-color:grey;
                    color: white;
                    cursor: pointer;
                    }
                </style>
            </t>
            <div class="cbt-page">
                <t t-call="cbt_portal.cbt_header"/>
                <div class="cbt-container" onselectstart="return false">
                    <div class="section section-form-wizard">
                        <t t-call="cbt_portal.cbt_widgets" t-if="paper"/>
                        <t t-call="cbt_portal.cbt_sections" t-if="paper"/>
                        <div t-if="paper" id="cbt_question_feedback"
                             class="modal cbt-feedback-modal" role="dialog"
                             aria-labelledby="cbt-feedback-title">
                            <div class="cbt-feedback-header">
                                <span class="material-icons" aria-hidden="true">rate_review</span>
                                <div>
                                    <h4 id="cbt-feedback-title">Question Feedback</h4>
                                    <p>Tell us about a concern with this question.</p>
                                </div>
                            </div>
                            <div class="modal-content">
                                <input type="hidden" id="cbt_feedback_question_id"/>
                                <input type="hidden" id="cbt_feedback_csrf"
                                       t-att-value="request.csrf_token()"/>
                                <div class="cbt-feedback-options"
                                     t-if="feedback_types">
                                    <t t-foreach="feedback_types" t-as="feedback_type">
                                        <p>
                                            <label>
                                                <input class="with-gap"
                                                       name="cbt_feedback_type"
                                                       type="radio"
                                                       t-att-value="feedback_type.id"
                                                       t-att-data-is-other="feedback_type.is_other"/>
                                                <span><t t-esc="feedback_type.name"/></span>
                                            </label>
                                        </p>
                                    </t>
                                </div>
                                <p t-else="" class="cbt-note">
                                    Feedback options are not configured. You can still type your feedback below.
                                </p>
                                <div class="input-field">
                                    <textarea id="cbt_feedback_text"
                                              class="materialize-textarea"
                                              maxlength="32767"></textarea>
                                    <label for="cbt_feedback_text">
                                        Additional details (optional)
                                    </label>
                                </div>
                                <p id="cbt_feedback_text_hint"
                                   class="cbt-note cbt-feedback-text-hint">
                                    Select Other to describe a different concern, or add details to your feedback.
                                </p>
                                <p id="cbt_feedback_status"
                                   class="cbt-feedback-status" role="status"/>
                            </div>
                            <div class="modal-footer cbt-feedback-footer">
                                <a href="#!"
                                   class="modal-close waves-effect waves-red btn-flat">
                                    Cancel
                                </a>
                                <button type="button" id="cbt_feedback_clear"
                                        class="waves-effect waves-light btn-flat">
                                    Clear
                                </button>
                                <button type="button" id="cbt_feedback_save"
                                        class="waves-effect waves-light btn cbt-btn gradient-45deg-indigo-light-blue">
                                    Save Feedback
                                </button>
                            </div>
                        </div>
                        <div t-if="paper" id="cbt_help_instructions"
                             class="modal cbt-help-modal"
                             role="dialog" aria-labelledby="cbt-help-title">
                            <div class="cbt-help-header">
                                <span class="material-icons cbt-help-icon"
                                      aria-hidden="true">help_outline</span>
                                <div>
                                    <h4 id="cbt-help-title">Test Instructions</h4>
                                    <p>Review these instructions while taking your test.</p>
                                </div>
                            </div>
                            <div class="modal-content cbt-instructions">
                                <t t-if="instructions">
                                    <t t-out="instructions.instruction"/>
                                </t>
                                <p t-else="" class="cbt-note">
                                    Instructions are not available. Please contact the invigilator.
                                </p>
                            </div>
                            <div class="modal-footer cbt-help-footer">
                                <a href="#!"
                                   class="modal-close waves-effect waves-light btn cbt-btn gradient-45deg-indigo-light-blue">
                                    Close
                                </a>
                            </div>
                        </div>
                        <div t-if="not paper" class="card cbt-panel">
                            <div class="card-content">
                                <p class="cbt-note center-align">Unable to load your paper. Please contact the invigilator.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <t t-call-assets="cbt_portal.assets_dashboard" t-css="false"/>
            <script src="/cbt_portal/static/js/paper.js"/>
        </t>
    </template>
    <template id="cbt_paper_review" name="">
        <t t-call="web.layout">
            <t t-set="body_classname" t-value="'cbt-portal-body'"/>
            <t t-set="title" t-value="'CBT - Review'"/>
            <t t-set="head">
                <t t-call-assets="cbt_portal.assets_dashboard" t-js="false"/>
                <script src="/cbt_portal/static/js/jquery-2.1.4.min.js"/>
                <script src="/cbt_portal/static/js/paginga_jquery.js"/>
                <style>
                    .firstPage{
                    background-color:#add3e6;

                    }
                    .previousPage{
                    background-color:#add3e6;

                    }
                    .nextPage{
                    background-color:#add3e6;

                    }
                    .lastPage{
                    background-color:#add3e6;

                    }
                    .firstPage:hover{
                    background-color:grey;
                    color: white;
                    }
                    .previousPage:hover{
                    background-color:grey;
                    color: white;
                    }
                    .nextPage:hover{
                    background-color:grey;
                    color: white;
                    }
                    .lastPage:hover{
                    background-color:grey;
                    color: white;
                    }

                </style>
            </t>
            <div class="cbt-page">
                <t t-call="cbt_portal.cbt_header"/>
                <div class="cbt-container">
                    <div class="section section-form-wizard">
                        <t t-call="cbt_portal.cbt_widgets" t-if="paper"/>
                        <t t-call="cbt_portal.cbt_review_sections" t-if="paper"/>
                        <div t-if="not paper" class="card cbt-panel">
                            <div class="card-content">
                                <p class="cbt-note center-align">Unable to load your paper. Please contact the invigilator.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <t t-call-assets="cbt_portal.assets_dashboard" t-css="false"/>
            <script src="/cbt_portal/static/js/paper.js"/>
            <script>
                window.addEventListener('contextmenu', function (e) {
                    e.preventDefault();
                }, false);
            </script>
        </t>
    </template>
</odoo>
