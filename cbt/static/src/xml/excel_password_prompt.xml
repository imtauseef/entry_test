<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cbt.ExcelPasswordPrompt">
        <div class="o_cbt_excel_password_page">
            <section class="o_cbt_excel_password_card">
                <h2 t-esc="params.title"/>
                <p class="text-muted">
                    Confirm your Odoo password to continue.
                </p>
                <form t-on-submit.prevent="submit">
                    <div class="mb-3">
                        <label for="cbt_excel_odoo_password"
                               class="form-label">Odoo login password</label>
                        <input id="cbt_excel_odoo_password"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               t-model="state.odooPassword"
                               required="required"
                               t-att-disabled="state.busy"/>
                    </div>
                    <div class="mb-3">
                        <label for="cbt_excel_workbook_password"
                               class="form-label">Workbook password</label>
                        <input id="cbt_excel_workbook_password"
                               type="password"
                               class="form-control"
                               autocomplete="off"
                               t-model="state.workbookPassword"
                               t-att-required="params.operation === 'export'"
                               t-att-disabled="state.busy"/>
                        <small class="form-text text-muted"
                               t-if="params.operation === 'export'">
                            Use at least 12 characters. Share this password
                            separately with the receiving administrator.
                        </small>
                        <small class="form-text text-muted" t-else="">
                            Leave blank only for a legacy workbook that was
                            not password-protected.
                        </small>
                    </div>
                    <div class="mb-3" t-if="params.operation === 'export'">
                        <label for="cbt_excel_workbook_password_confirm"
                               class="form-label">Confirm workbook password</label>
                        <input id="cbt_excel_workbook_password_confirm"
                               type="password"
                               class="form-control"
                               autocomplete="off"
                               t-model="state.confirmWorkbookPassword"
                               required="required"
                               t-att-disabled="state.busy"/>
                    </div>
                    <div t-if="state.error"
                         class="alert alert-danger"
                         role="alert"
                         t-esc="state.error"/>
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary"
                                t-att-disabled="state.busy">
                            <t t-if="state.busy">Processing...</t>
                            <t t-else="">Continue</t>
                        </button>
                        <button type="button"
                                class="btn btn-secondary"
                                t-att-disabled="state.busy"
                                t-on-click="cancel">
                            Cancel
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </t>
</templates>
