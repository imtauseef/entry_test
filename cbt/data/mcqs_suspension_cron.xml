<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_cbt_resume_suspended_questions" model="ir.cron">
            <field name="name">CBT: Resume suspended questions</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="state">code</field>
            <field name="code">model._cron_resume_suspended_questions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <!-- Run every day at 12:00 AM (midnight) -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0)"/>
        </record>
    </data>
</odoo>
