<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="cbt_student_paper_tree" model="ir.ui.view">
            <field name="name">cbt.student.paper.tree</field>
            <field name="model">cbt.student.paper</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="participant_id" options="{'no_open': True}"/>
                    <field name="main_paper_id" options="{'no_open': True}"/>
                </tree>
            </field>
        </record>

        <record id="cbt_student_paper_form" model="ir.ui.view">
            <field name="name">cbt.student.paper.form</field>
            <field name="model">cbt.student.paper</field>
            <field name="arch" type="xml">
                <form edit="false" create="false">
                    <header>
                        <button name="%(cbt_report_print_wizard_action)d" string="Print Paper" type="action"
                                class="btn-primary"
                                context="{'default_report_ref': 'cbt.student_paper_question_report', 'default_res_model': 'cbt.student.paper', 'default_res_id': id}"/>
                        <button name="%(cbt_report_print_wizard_action)d" string="Print Answer Key" type="action"
                                groups="cbt.group_cbt_reviewer,cbt.group_cbt_admin"
                                context="{'default_report_ref': 'cbt.student_paper_answer_key_report', 'default_res_model': 'cbt.student.paper', 'default_res_id': id}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="participant_id" required="1" options="{'no_open': True}"/>
                                <field name="main_paper_id" options="{'no_open': True}"/>
                            </group>
                        </group>
                        <field name="questions" required="1" options="{'no_open': True}"/>
                    </sheet>
                    <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
            </field>
        </record>
        <record id="cbt_student_paper_action" model="ir.actions.act_window">
            <field name="name">Student Papers</field>
            <field name="res_model">cbt.student.paper</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create the First Paper here.
                </p>
            </field>
        </record>
        <menuitem
                name="Student Papers"
                id="cbt_student_paper_menu"
                parent="cbt_config_paper_menu"
                action="cbt_student_paper_action"/>
    </data>
</odoo>