<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="cbt_employee_role_tree" model="ir.ui.view">
            <field name="name">cbt.employee.role.tree</field>
            <field name="model">cbt.employee.role</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="employee_id" options="{'no_open': True}"/>
                    <field name="subject_id" options="{'no_open': True}"/>
                    <field name="topic_id" options="{'no_open': True}"/>
                    <field name="subtopic_id" options="{'no_open': True}"/>
                    <field name="user_id" optional="show"/>
                    <field name="subject_ids" widget="many2many_tags"/>
                    <field name="topic_ids" widget="many2many_tags"/>
                    <field name="subtopic_ids" widget="many2many_tags"/>
                    <field name="create_access"/>
                    <field name="review_access"/>
                </tree>
            </field>
        </record>

        <record id="cbt_employee_role_form" model="ir.ui.view">
            <field name="name">cbt.employee.role.form</field>
            <field name="model">cbt.employee.role</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                               <field name="employee_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True,}"/>
                               <field name="user_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True,}"/>
                               <field name="subject_ids" widget="many2many_tags" options="{'no_quick_create':True,'no_create_edit':True,'no_create':True,}"/>
                            </group>
                            <group>
                                <field name="topic_ids" widget="many2many_tags" domain="[('subject_id','in',subject_ids)]" options="{'no_quick_create':True,'no_create_edit':True,'no_create':True,}"/>
                                <field name="subtopic_ids" widget="many2many_tags" domain="[('topic_id','in',topic_ids)]" options="{'no_quick_create':True,'no_create_edit':True,'no_create':True,}"/>
                                <field name="create_access"/>
                                <field name="review_access"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="cbt_employee_role_search" model="ir.ui.view">
        <field name="name">cbt.employee.role.search</field>
        <field name="model">cbt.employee.role</field>
        <field name="priority" eval="14"/>
        <field name="arch" type="xml">
            <search string="Employee Roles">
                <field name="employee_id" options="{'no_open': True}"/>
                <field name="subject_id" options="{'no_open': True}"/>
                <field name="topic_id" options="{'no_open': True}"/>
                <field name="subtopic_id" options="{'no_open': True}"/>
                <field name="user_id"/>
                <field name="subject_ids"/>
                <field name="topic_ids"/>
                <field name="subtopic_ids"/>
                <filter name="question_creator" string="Question Creator"
                        domain="[('create_access', '=', True)]"/>
                <filter name="reviewer" string="Reviewer"
                        domain="[('review_access', '=', True)]"/>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter name="group_employee" string="Faculty" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_user" string="User" domain="[]"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_creator" string="Question Creator"
                            domain="[]" context="{'group_by': 'create_access'}"/>
                    <filter name="group_reviewer" string="Reviewer"
                            domain="[]" context="{'group_by': 'review_access'}"/>
                </group>
            </search>
        </field>
    </record>

        <record id="cbt_employee_role_action" model="ir.actions.act_window">
            <field name="name">Faculty Roles</field>
            <field name="res_model">cbt.employee.role</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" />
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create the First Faculty Role here.
                </p>
            </field>
        </record>

        <!-- <menuitem
                name="Faculty Roles"
                id="cbt_employee_role_menu"
                parent="cbt_employee_root"
                action="cbt_employee_role_action"/> -->
    </data>
</odoo>
