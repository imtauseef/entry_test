<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="cbt_paper_tree" model="ir.ui.view">
            <field name="name">cbt.paper.tree</field>
            <field name="model">cbt.paper</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="name"/>
                    <field name="slot_id"/>
                    <field name="program_ids" widget='many2many_tags'/>
                </tree>
            </field>
        </record>

        <record id="cbt_papers_form" model="ir.ui.view">
            <field name="name">cbt.paper.form</field>
            <field name="model">cbt.paper</field>
            <field name="arch" type="xml">
                <form edit="false" create="false">
                    <header>
                         <button name="generate_student_paper" string="Generate Student Questions" type="object" class="btn-primary"
                                 invisible="student_paper_gen"/>
                         <button name="%(cbt_report_print_wizard_action)d" string="Print Paper" type="action"
                                 class="btn-primary"
                                 context="{'default_report_ref': 'cbt.entry_test_paper', 'default_res_model': 'cbt.paper', 'default_res_id': id}"/>
                         <button name="%(cbt_report_print_wizard_action)d" string="Print Answer Key" type="action"
                                 groups="cbt.group_cbt_reviewer,cbt.group_cbt_admin"
                                 context="{'default_report_ref': 'cbt.paper_answer_key_report', 'default_res_model': 'cbt.paper', 'default_res_id': id}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="number_of_questions"/>
                            </group>
                            <group>
                                <field name="slot_id" required="1"/>
                                <field name="program_ids" widget='many2many_tags'/>
                                <field name="student_paper_gen" hidden="1"/>
                                <field name="state" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="Questions" string="Questions">
                                <field name="questions" required="1"
                                       context="{'cbt_paper_id': id}">
                                    <tree create="false" delete="false">
                                        <field name="subject_id"/>
                                        <field name="topic_id"/>
                                        <field name="difficulty_level_id"/>
                                        <field name="question"/>
                                        <button name="action_replace_question" string="Replace"
                                                type="object" class="btn-secondary"
                                                context="{'cbt_paper_id': parent.id}"
                                                invisible="parent.state != 'draft'"
                                                confirm="Replace this question with a random question from the question bank? The replaced question will be moved to the reserve pool."/>
                                    </tree>
                                </field>
                            </page>
                            <page name="Replacements" string="Replacements">
                                <field name="replacement_log_ids" readonly="1">
                                    <tree create="false" delete="false" edit="false">
                                        <field name="replace_datetime"/>
                                        <field name="line_sequence" string="Line"/>
                                        <field name="old_question_id"/>
                                        <field name="new_question_id"/>
                                        <field name="match_level"/>
                                        <field name="user_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
            </field>
        </record>
        <record id="cbt_paper_action" model="ir.actions.act_window">
            <field name="name">Paper</field>
            <field name="res_model">cbt.paper</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create the First Paper here.
                </p>
            </field>
        </record>
        <menuitem
                name="Papers"
                id="cbt_paper_menu"
                parent="cbt_config_paper_menu"
                action="cbt_paper_action"/>
    </data>
</odoo>