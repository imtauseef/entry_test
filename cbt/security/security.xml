<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_cbnet" model="ir.module.category">
            <field name="name">CBNET</field>
            <field name="description">Helps you handle your cbnet needs.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_cbt_faculty" model="res.groups">
            <field name="name">CBNET Faculty</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_cbt_creator" model="res.groups">
            <field name="name">CBNET Question Creator</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
        </record>

        <record id="group_cbt_reviewer" model="res.groups">
            <field name="name">CBNET Question Reviewer</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
        </record>

        <record id="group_cbt_user" model="res.groups">
            <field name="name">CBNET User</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
        </record>


        <record id="group_cbt_admin" model="res.groups">
            <field name="name">CBNET Admin</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('cbt.group_cbt_user'))]"/>
        </record>

<!--        <record model="ir.rule" id="partner_view_rule_faculty">-->
<!--            <field name="name">Faculty View Rule</field>-->
<!--            <field name="model_id" ref="model_cbt_mcqs"/>-->
<!--            <field name="global" eval="False"/>-->
<!--            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]" />-->
<!--            <field name="domain_force">[('current_user', '=', user.id)]</field>-->
<!--        </record>-->

         <record model="ir.rule" id="partner_view_rule_admin">
            <field name="name">Admin View Rule</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_admin'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record model="ir.rule" id="partner_view_rule_faculty_submitted">
            <field name="name">Faculty Submitted Questions Rule</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]" />
            <field name="domain_force">['|', '|', '&amp;', ('state', '=', 'draft'), ('current_user', '=', user.id), '&amp;', ('state', '=', 'submitted'), ('current_user', '!=', user.id), ('state', 'in', ['approved', 'cancel'])]</field>
        </record>

        <record model="ir.rule" id="paper_replacement_log_rule_faculty">
            <field name="name">Paper Replacement Log: Faculty Read</field>
            <field name="model_id" ref="model_cbt_paper_replacement_log"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record model="ir.rule" id="paper_replacement_log_rule_admin">
            <field name="name">Paper Replacement Log: Admin</field>
            <field name="model_id" ref="model_cbt_paper_replacement_log"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>

    <data>
        <function model="cbt.employee.role" name="_sync_all_role_groups"/>
    </data>
</odoo>