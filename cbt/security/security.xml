        <!-- Question bank: a faculty member only sees questions of assigned
             subjects. A creator's own submitted question is hidden from that
             creator until it is approved. Submitted questions are visible to
             other reviewers with review access in the same subject. -->
        <record model="ir.rule" id="cbt_mcqs_faculty_read_rule">
            <field name="name">Questions: Faculty Read Own Subject</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
            <field name="domain_force">[('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id)]), '|', ('state', 'in', ['approved', 'cancel']), '|', '&amp;', ('state', '=', 'draft'), ('current_user', '=', user.id), '&amp;', ('state', '=', 'submitted'), ('current_user', '!=', user.id), ('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id), ('review_access', '=', True)])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record model="ir.rule" id="cbt_mcqs_faculty_write_rule">
            <field name="name">Questions: Faculty Write Own Subject</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
            <field name="domain_force">[('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id)]), '|', '&amp;', ('state', '=', 'draft'), ('current_user', '=', user.id), '|', '&amp;', '&amp;', ('state', '=', 'submitted'), ('current_user', '!=', user.id), ('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id), ('review_access', '=', True)]), '&amp;', ('state', 'in', ['approved', 'cancel']), ('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id), ('review_access', '=', True)])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record model="ir.rule" id="cbt_mcqs_faculty_unlink_rule">
            <field name="name">Questions: Faculty Unlink Own Draft</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
            <field name="domain_force">[('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id)]), ('state', '=', 'draft'), ('current_user', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record model="ir.rule" id="cbt_mcqs_admin_rule">
            <field name="name">Questions: Admin All</field>
            <field name="model_id" ref="model_cbt_mcqs"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record model="ir.rule" id="cbt_mcqs_audit_log_faculty_rule">
            <field name="name">Question Audit Log: Faculty Question Scope</field>
            <field name="model_id" ref="model_cbt_mcqs_audit_log"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
            <field name="domain_force">[('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id)]), '|', ('question_state', 'in', ['approved', 'cancel']), '|', '&amp;', ('question_state', '=', 'draft'), ('question_owner_id', '=', user.id), '&amp;', ('question_state', '=', 'submitted'), ('question_owner_id', '!=', user.id), ('subject_id.role_ids', 'any', [('employee_id.user_id', '=', user.id), ('review_access', '=', True)])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
