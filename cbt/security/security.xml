        <record id="group_cbt_faculty" model="res.groups">
            <field name="name">CBNET Faculty</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_cbt_creator" model="res.groups">
            <field name="name">CBNET Question Creator</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
        </record>

        <record id="group_cbt_reviewer" model="res.groups">
            <field name="name">CBNET Question Reviewer</field>
            <field name="category_id" ref="module_category_cbnet"/>
            <field name="implied_ids" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
