    <data>

        <!-- Faculty only sees subject, topic and sub-topic masters that are
             linked to one of their own employee roles. Admin sees everything. -->
        <record model="ir.rule" id="cbt_subject_faculty_rule">
            <field name="name">Subject: Faculty Own Subjects</field>
            <field name="model_id" ref="model_cbt_subject"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_faculty'))]"/>
            <field name="domain_force">[('role_ids', 'any', [('employee_id.user_id', '=', user.id)])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record model="ir.rule" id="cbt_subject_admin_rule">
            <field name="name">Subject: Admin All</field>
            <field name="model_id" ref="model_cbt_subject"/>
            <field name="groups" eval="[(4, ref('cbt.group_cbt_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

