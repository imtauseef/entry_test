<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="cbt_report_print_wizard_view" model="ir.ui.view">
            <field name="name">cbt.report.print.wizard.form</field>
            <field name="model">cbt.report.print.wizard</field>
            <field name="arch" type="xml">
                <form string="Print">
                    <group>
                        <field name="print_format" widget="radio"/>
                        <field name="report_ref" invisible="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_print" string="Print" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="cbt_report_print_wizard_action" model="ir.actions.act_window">
            <field name="name">Print</field>
            <field name="res_model">cbt.report.print.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="cbt_report_print_wizard_view"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
